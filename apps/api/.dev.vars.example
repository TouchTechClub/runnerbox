# Copy to `.dev.vars` for `wrangler dev`. Never commit real values.

# GitHub App — https://github.com/settings/apps/<your-app>
GITHUB_APP_ID=123456
# PEM-encoded RSA private key. Keep the \n escapes on one line, or use a real
# multi-line PEM inside quotes — both are handled.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMII...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_WEBHOOK_SECRET=whsec_change_me

# OAuth ("identify users") credentials from the same GitHub App page.
# Callback URL to register there: {API_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# better-auth session signing secret — `openssl rand -hex 32`
BETTER_AUTH_SECRET=change_me_to_a_32+_char_random_string

# Origin of the web app (CORS, post-login redirects, CLI verify URLs) and of
# this API (better-auth baseURL). API_URL defaults to the wrangler dev origin.
APP_URL=http://localhost:3000
API_URL=http://localhost:8787
