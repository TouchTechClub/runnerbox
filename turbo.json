{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false,
      "interactive": true
    },
    "db:migrate": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "interactive": true
    }
  },
  "globalEnv": ["BETTER_AUTH_SECRET", "RUNNERBOX_API_URL", "VITE_API_URL", "CI"],
  "globalDependencies": [".env*", "apps/*/.env*", "apps/*/.dev.vars"]
}
